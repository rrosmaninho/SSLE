# Identity and location for the ingestion service, read at start-up.
# deploy/incus/deploy-services.sh writes the real file to /etc/ssle/env.
SERVICE_KIND=ingestion
SERVICE_NAME=ingestion-01.node1.rack1.dc-aveiro.pt-centro.pt
SERVICE_PORT=5001
REGISTRY_URL=http://registry.incus:5050
REGION=pt-centro.pt
DC=dc-aveiro
RACK=rack1
NODE=node1
