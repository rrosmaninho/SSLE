# Identity and location for the registry service, read at start-up.
# deploy/incus/deploy-services.sh writes the real file to /etc/ssle/env.
SERVICE_KIND=registry
SERVICE_NAME=registry-01.node1.rack1.dc-aveiro.pt-centro.pt
SERVICE_PORT=5050
REGISTRY_URL=http://registry.incus:5050
REGION=pt-centro.pt
DC=dc-aveiro
RACK=rack1
NODE=node1
