# Identity and location for the sensor service, read at start-up.
# deploy/incus/deploy-services.sh writes the real file to /etc/ssle/env.
SERVICE_KIND=sensor
SERVICE_NAME=sensor-01.node1.rack1.dc-aveiro.pt-centro.pt
SERVICE_PORT=9101
REGISTRY_URL=http://registry.incus:5050
REGION=pt-centro.pt
DC=dc-aveiro
RACK=rack1
NODE=node1
SENSOR_COUNT=5
